# Sales Agent settings. Fill in the REQUIRED values, then run the installer.
# Empty values keep the current value (or the default); "-" clears a value (e.g. KEY=- switches an integration off).
# SYSTEM_ADMIN_PASSWORD is hashed during installation and then removed from this file.
# Use http://host.docker.internal:<port> for services running on this computer.

# ---- Required: OpenAI-compatible LLM ----
# Chat model name, LiteLLM format (e.g. openai/Qwen/Qwen3-Coder-30B-A3B-Instruct)
LITELLM_PROVIDER_MODEL_NAME=                # REQUIRED
# OpenAI-compatible LLM base URL (e.g. http://llm-server:8000/v1)
OPENAI_API_BASE=                # REQUIRED
# API key of that LLM endpoint (EMPTY if none)
OPENAI_API_KEY=                # REQUIRED; default: EMPTY
LITELLM_PROVIDER_API_KEY=                # optional
LITELLM_PROVIDER_BASE_URL=                # optional
QWEN_MODEL_NAME=                # optional
LLM_PROVIDER=                # optional; litellm|ollama; default: litellm
MAX_MODEL_LEN=                # optional
LITELLM_EMBEDDING_MODEL_NAME=                # optional

# ---- Required: Google Gemini ----
# Google Gemini API key
GEMINI_API_KEY=                # REQUIRED

# ---- Required: administrator account ----
# Administrator user name
SYSTEM_ADMIN_USERNAME=                # REQUIRED; default: admin
# Administrator e-mail
SYSTEM_ADMIN_EMAIL=                # REQUIRED
# Administrator password (min. 12 characters)
SYSTEM_ADMIN_PASSWORD=                # REQUIRED
SYSTEM_ADMIN_NAME=                # optional; default: System Administrator

# ---- Installation (optional) ----
# Port for the web application (http://localhost:<port>)
APP_PORT=                # optional; default: 8080
BIND_ADDRESS=                # optional; 127.0.0.1|0.0.0.0; default: 127.0.0.1
PUBLIC_HOST=                # optional; default: localhost
PUBLIC_BASE_URL=                # optional
BACKEND_VARIANT=                # optional; auto|cpu|cuda; default: auto
SERVICE_AGENT_DATA_DIR=                # optional
SEED_BUNDLE=                # optional

# ---- Optional: Ollama (set OLLAMA_BASE_URL to enable) ----
OLLAMA_BASE_URL=                # optional
OLLAMA_MODEL=                # optional; default: qwen3-coder:30b

# ---- Optional: translation LLM (set TRANSLATION_API_URL to enable) ----
TRANSLATION_API_URL=                # optional
TRANSLATION_MODEL_NAME=                # optional; default: gemma4:31b

# ---- Optional: vision LLM (set VLM_URL to enable) ----
VLM_URL=                # optional
VLM_MODEL=                # optional; default: Qwen/Qwen3.5-35B-A3B-FP8
VLM_PARALLEL_WORKERS=                # optional; default: 8

# ---- Optional: Oracle (set ORACLE_DB_URL to enable) ----
ORACLE_DB_URL=                # optional
ORACLE_DB_USERNAME=                # optional
ORACLE_DB_PASSWORD=                # optional

# ---- Optional: iKonnect MSSQL (set IKONNECT_MSSQL_DB_HOST to enable) ----
IKONNECT_MSSQL_DB_HOST=                # optional
IKONNECT_MSSQL_DB_PORT=                # optional; default: 1433
IKONNECT_MSSQL_DB_NAME=                # optional
IKONNECT_MSSQL_DB_USER=                # optional
IKONNECT_MSSQL_DB_PASSWORD=                # optional

# ---- Optional: LDAP / Active Directory (set LDAP_HOST to enable) ----
LDAP_HOST=                # optional
LDAP_PORT=                # optional; default: 389
LDAP_USE_TLS=                # optional; default: false
LDAP_SEARCH_BASE=                # optional
LDAP_DOMAIN=                # optional
LDAP_UPN_SUFFIX=                # optional
LDAP_SERVICE_BIND_DN=                # optional
LDAP_SERVICE_BIND_PASSWORD=                # optional
LDAP_BIND_TIMEOUT=                # optional; default: 5
LDAP_SEARCH_TIMEOUT=                # optional; default: 5

# ---- Optional: SMTP relay for one-time login codes (set SMTP_HOST to enable) ----
SMTP_HOST=                # optional
SMTP_PORT=                # optional; default: 587
SMTP_USE_TLS=                # optional; default: true
SMTP_FROM=                # optional
OTP_EMAIL_APP_NAME=                # optional; default: Sales Agent
OTP_LENGTH=                # optional; default: 6
OTP_EXPIRE_SECONDS=                # optional; default: 600
OTP_MAX_VERIFY_ATTEMPTS=                # optional; default: 5
OTP_RESEND_COOLDOWN_SECONDS=                # optional; default: 60
OTP_LOCK_SECONDS=                # optional; default: 900

# ---- Advanced: sessions and cookies ----
ALGORITHM=                # optional; HS256|HS384|HS512; default: HS256
ACCESS_TOKEN_EXPIRE_MINUTES=                # optional; default: 60
REFRESH_TOKEN_EXPIRE_MINUTES=                # optional; default: 480
JWT_LEEWAY_SECONDS=                # optional; default: 30
MAX_CONCURRENT_SESSIONS=                # optional; default: 2
LOGIN_RATE_LIMIT_MAX=                # optional; default: 10
LOGIN_RATE_LIMIT_WINDOW=                # optional; default: 60
COOKIE_SECURE=                # optional; default: false
COOKIE_SAMESITE=                # optional; lax|strict|none; default: lax

# ---- Advanced: application ----
ENABLE_GENERAL_ASSISTANT=                # optional; default: true
AGENT_ACCESS_ENFORCEMENT=                # optional; default: true
MAX_FILE_SIZE_MB=                # optional; default: 50
PARLANT_TOOL_RESULT_MAX_PAYLOAD_KB=                # optional; default: 10240
